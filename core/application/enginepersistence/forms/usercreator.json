{
    "type": "form",
    "name": "user_creator",
    "elements": [
        {
            "type": "query",
            "id": "query",
            "text": "Please enter a username and create a password:"
        },
        {
            "type": "textbox",
            "id": "username",
            "field": "username",
            "position": [0.5, 0.3]
        },
        {
            "type": "textbox",
            "id": "password",
            "field": "password",
            "password": true,
            "position": [0.5, 0.4]
        },
        {
            "type": "button",
            "id": "submit",
            "text": "Submit",
            "position": [0.5, 0.75],
            "action": "submit"
        }
    ],
    "error_element": "query"
}