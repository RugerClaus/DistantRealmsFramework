{
    "app_name": "myapp_Latest_Linux",
    "main": "main.py",
    "updater_main": "updater.py",
    "updater_name": "updater",

    "paths": {
        "dist": "executable",
        "build": "build",
        "specs": "specs"
    },

    "build": {
        "mode": "onedir",
        "icon": "assets/images/build/myapp_Latest_Linux.png",
        "windowed": true,
        "noconsole": true,
        "debug": true
    },

    "assets": [
        "assets",
        "logs",
        "saves",
        "environment"
    ],

    "copy": [
        "enginepersistence",
        "changelog.txt",
        "README.md",
        "LICENSE",
        "instructions.md"
    ],

    "cleanup_internal": [
        "assets",
        "logs",
        "saves",
        "environment"
    ],

    "updater": {
        "enabled": true,
        "mode": "onefile",
        "console": true
    },

    "archive": {
        "enabled": true,
        "name": "myapp_Latest_Linux.zip",
        "directory": "myapp_Latest_Linux"
    },

    "deployment": {
        "server": "user@hostname",
        "remote_dir": "mywebsite.tld/path/to/dir/"
    }
}